from ultralytics import YOLO
import cv2
import pyttsx3
import threading
import time

# ─── INIT ───────────────────────────────────────────
model = YOLO("yolov8n.pt")
engine = pyttsx3.init()
engine.setProperty('rate', 155)
engine.setProperty('volume', 1.0)

MOBILE_STREAM = "http://192.168.1.5:8080/video"
CONFIDENCE_THRESHOLD = 0.55
SPEECH_COOLDOWN = 3  # seconds

last_spoken = {}

# ─── SPEECH ─────────────────────────────────────────
def speak(text):
    def _speak():
        engine.say(text)
        engine.runAndWait()
    t = threading.Thread(target=_speak)
    t.daemon = True
    t.start()

def announce_object(label):
    now = time.time()
    if label not in last_spoken or (now - last_spoken[label]) > SPEECH_COOLDOWN:
        last_spoken[label] = now
        speak(f"I see a {label}")

# ─── MAIN LOOP ───────────────────────────────────────
def main():
    cap = cv2.VideoCapture(MOBILE_STREAM)
    speak("VisionAid is now active. Point the camera at objects.")

    while True:
        ret, frame = cap.read()
        if not ret:
            speak("Camera disconnected")
            break

        results = model(frame, verbose=False)

        for result in results:
            for box in result.boxes:
                conf = float(box.conf[0])
                if conf < CONFIDENCE_THRESHOLD:
                    continue

                cls_id = int(box.cls[0])
                label = model.names[cls_id]
                announce_object(label)

                # Visual feedback (for developer/demo)
                x1, y1, x2, y2 = map(int, box.xyxy[0])
                cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 200, 0), 2)
                cv2.putText(frame, f"{label} ({conf:.0%})",
                           (x1, y1 - 8),
                           cv2.FONT_HERSHEY_SIMPLEX, 0.65,
                           (0, 200, 0), 2)

        cv2.imshow("VisionAid [Press Q to quit]", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()
    speak("VisionAid shutting down. Goodbye.")

if __name__ == "__main__":
    main()
